{
  "name": "luminoengine",
  "version": "0.11.0",
  "description": "",
  "main": "lib/lumino.js",
  "module": "lib/lumino.mjs",
  "types": "lib/index.d.ts",
  "scripts": {
    "build:ffi": "cd ../.. && dotnet run -- BuildEngine wasm32-emscripten",
    "build:copy_ffi": "copyfiles -f ../../build/buildtrees/wasm32-emscripten/lumino/packages/LuminoFFI/LuminoFFI.js ../../build/buildtrees/wasm32-emscripten/lumino/packages/LuminoFFI/LuminoFFI.wasm lib",
    "build:rollup": "rollup --config ./rollup.config.mjs",
    "build:typecheck": "tsc -P ./tsconfig.json --noEmit",
    "build": "run-s build:ffi build:copy_ffi build:typecheck build:rollup",
    "start": "http-server -p 8080 .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "copyfiles": "^2.4.1",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.13.0",
    "rollup-plugin-esbuild": "^6.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3"
  }
}
