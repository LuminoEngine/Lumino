{
    "name": "luminojs",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "lib/luminojs.mjs",
    "module": "lib/luminojs.mjs",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.ts",
                "default": "./lib/luminojs.mjs"
            },
            "require": {
                "types": "./lib/index.d.ts",
                "default": "./lib/luminojs.mjs"
            }
        }
    },
    "types": "lib/index.d.ts",
    "license": "MIT",
    "description": "TypeScript / WebAssembly bindings for Lumino.",
    "files": ["bin/**", "lib/**"],
    "scripts": {
        "build:typecheck": "tsc --noEmit",
        "build:rollup": "rollup --config rollup.config.mjs",
        "build": "npm run build:typecheck && npm run build:rollup",
        "dev": "npx serve . --cors",
        "pretest:smoke": "npm run build",
        "test:smoke": "playwright test --config test/smoke/playwright.config.mjs"
    },
    "devDependencies": {
        "@playwright/test": "1.59.1",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-typescript": "^11.1.6",
        "rollup": "^4.13.0",
        "tslib": "^2.6.2",
        "typescript": "^5.4.3"
    },
    "dependencies": {
        "serve": "^14.2.6"
    }
}
