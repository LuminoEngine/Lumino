{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "allowJs": false,
        "sourceMap": true,
        "strict": true,
        "declaration": true,

        // これを指定しないと、Lumino がサブリポジトリとしてクローンされている場合など、
        // 祖先リポジトリの node_modules/@types を参照してしまうことがある。
        "types": []
    },
    "include": ["src"],
    "exclude": ["node_modules", "lib", "sandbox"]
}
